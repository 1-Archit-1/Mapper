
# ========================================
# Location Shape Mapper Configuration
# ========================================
# Copy this file to '.env' and fill in your settings
# Lines starting with # are comments

# ========================================
# DATABASE CONNECTION
# ========================================

# Set to 'false' to use CSV input instead of database
use_db_for_source_data  = 'false'

# Your SQL Server name (e.g., localhost, MYSERVER\SQLEXPRESS, catdb-uat)
server='catdb-uat'

# Database name (without brackets - they will be stripped automatically)
database='Zurich_CDSC_24Q3_EDM'

# Table name containing location data (with or without brackets both work)
table='[dbo].[AON_loc_score_map_v2_with_latlon]'



# =======================================
# CSV INPUT (if not using database)
# =======================================
# Full path to your CSV file (if not using database)
# Use forward slashes / or enclose in quotes if path has spaces
# Example: 'C:/data/locations.csv' or 'E:/GIS Data/locations.csv'
csv_input_path = 'test_files/InputReverseGeocMilton.csv'




# ========================================
# COORDINATE COLUMNS
# ========================================
# Column names for latitude and longitude in your table (case-sensitive)
latitude_col='Latitude'
longitude_col='Longitude'



# ========================================
# PRIMARY KEY (Optional)
# ========================================
# Use a primary key to avoid duplicate locations?
# Options: 'true' or 'false'
# If true, only unique rows based on primary key will be kept (only key + lat/lon columns)
use_primary_key = 'false'

# If using primary key, specify column names (comma-separated for composite keys)
# Example: 'LocID'  or  'LocNumber,AcctNumber'
primary_key_cols = 'LocNumber,AcctNumber'




# ========================================
# SHAPEFILE/RASTER INPUT
# ========================================
# Full path to your shapefile/raster ( .geojson or .tif )
# Use forward slashes / or enclose in quotes if path has spaces
# Examples:
#   'test_files/Jasper.geojson'
#   'E:/GIS Data/boundary.geojson'
#   'test_files/rasters/MILTON_2024_adv08_e10_ResultRaster.tif'
shapefile_path = 'test_files/Jasper.geojson'
rasterfile_path = 'test_files/rasters/MILTON_2024_adv08_e10_ResultRaster.tif'



# ========================================
# OUTPUT OPTIONS
# ========================================

# Save results to database?
# Options: 'true' or 'false'
save_to_db = 'true'

# Output table name (if saving to database)
output_table_name = 'test'

# Save as GeoJSON file?
# Options: 'true' or 'false'
save_joined_geojson = 'true'

# GeoJSON output path
output_geojson = 'outputs/xx.geojson'

# Save as CSV file?
# Options: 'true' or 'false'
save_to_csv = 'true'

# CSV output path
output_csv = 'outputs/XX.csv'

# Save map image?
# Options: 'true' or 'false'
save_map_image = 'true'

# Map image output path (supports .png, .jpg, .pdf)
output_map = 'outputs/xx.png'


